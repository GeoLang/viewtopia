# Copy to .env.platform and fill both in with `openssl rand -base64 48`.
# Generate once and keep them: a new secret invalidates every live session.

# one HS256 secret shared by every service that validates JWTs, so a token
# minted by one is accepted by the others. services that need it refuse to
# start on an empty value.
PLATFORM_JWT_SECRET=

# what geolang-api presents to geolang-executor, which runs tool code and holds
# no signing secret of its own.
GEOLANG_EXECUTOR_SECRET=

# Copy to .env.platform and fill the two secrets in with `openssl rand -base64 48`.
# Generate once and keep them: a new secret invalidates every live session.

# one HS256 secret shared by every service that validates JWTs, so a token
# minted by one is accepted by the others. services that need it refuse to
# start on an empty value.
PLATFORM_JWT_SECRET=

# what geolang-api presents to geolang-executor, which runs tool code and holds
# no signing secret of its own.
GEOLANG_EXECUTOR_SECRET=

# the origin clients open the viewer at, with no trailing slash. tiletopia's
# WMTS, TMS and Ion urls start with it. compose stops on an empty value.
TILETOPIA_ION_BASE_URL=

TILETOPIA_GLOBAL_TERRAIN_DEM_URL=
TILETOPIA_GLOBAL_TERRAIN_GEOID_URL=
TILETOPIA_GLOBAL_TERRAIN_CACHE_DIR=
TILETOPIA_GLOBAL_TERRAIN_CACHE_MB=
TILETOPIA_GLOBAL_TERRAIN_ION_ASSET_ID=

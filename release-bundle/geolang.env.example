# Copy to geolang.env, beside the compose files. Read by sibyl and geolang-api.
# All of it is optional: Settings, AI Model in the viewer can set the same
# values, stores them, and overrides this file on the next start.

# a cloud provider key, with the base url and models it serves
SIBYL_CLOUD_API_KEY=
SIBYL_CLOUD_API_BASE=https://api.x.ai/v1
SIBYL_CLOUD_MODELS=grok-4-1-fast-reasoning

# or an OpenAI-compatible server on the host instead of a cloud provider
#SIBYL_LOCAL_API_BASE=http://host.docker.internal:18200/v1
#SIBYL_LOCAL_MODELS=Qwen3.5-9B-Q4_K_M

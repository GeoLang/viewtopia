[
  {
    "name": "basemap.set",
    "description": "Put a basemap under the layers.",
    "parameters": {
      "type": "object",
      "properties": {
        "basemap": {
          "type": "string",
          "description": "which basemap to draw",
          "enum": [
            "osm",
            "satellite",
            "topo",
            "dark",
            "liberty",
            "bright",
            "positron",
            "selfhosted"
          ]
        }
      },
      "required": [
        "basemap"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
    "name": "camera.fly_to",
    "description": "Fly the camera to a longitude and latitude.",
    "parameters": {
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "description": "Longitude in degrees, -180 to 180."
        },
        "lat": {
          "type": "number",
          "description": "Latitude in degrees, -90 to 90."
        },
        "height": {
          "type": "number",
          "description": "Height above the ground in metres."
        },
        "heading": {
          "type": "number",
          "description": "Compass bearing in degrees, 0 is north."
        },
        "pitch": {
          "type": "number",
          "description": "Tilt in degrees, negative looks down at the ground."
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
    "name": "dataset.draw_branch",

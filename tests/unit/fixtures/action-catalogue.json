  {
    "name": "scenario.compare",
    "description": "Compare two branches of a dataset side by side, with the ground each one covers.",
    "parameters": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Dataset id or name."
        },
        "base_branch": {
          "type": "string",
          "description": "Branch id or name to compare against."
        },
        "scenario_branch": {
          "type": "string",
          "description": "Branch id or name being proposed."
        },
        "distance": {
          "type": "number",
          "description": "How far a feature reaches, in metres. 50 by default."
        },
        "base_at": {
          "type": "string",
          "description": "ISO 8601 moment to draw the base branch at."
        },
        "scenario_at": {
          "type": "string",
          "description": "ISO 8601 moment to draw the scenario branch at."
        }
      },
      "required": [
        "dataset",
        "base_branch",
        "scenario_branch"
      ]
    },
    "reads": false,
    "destructive": false
  },

    "parameters": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Dataset id or name."
        },
        "branch": {
          "type": "string",
          "description": "Branch id or name, main by default."
        },
        "at": {
          "type": "string",
          "description": "ISO 8601 moment to draw the branch as it stood then."
        }
      },
      "required": [
        "dataset"
      ]
    },
    "reads": false,
    "destructive": false
